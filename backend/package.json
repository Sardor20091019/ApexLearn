{
  "name": "apexlearn",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true });\"",
    "build": "nest build && npm run build --prefix ../frontend",
    "start": "nest start",
    "db:migrate": "tsx src/database/migrate.ts",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "concurrently \"node dist/main\" \"npm start --prefix ../frontend\"",
    "build:monolith": "npm install && npm install --prefix ../frontend && npm run build",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "jest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1125.0",
    "@bull-board/api": "^9.10.1",
    "@bull-board/express": "^9.10.1",
    "@bull-board/nestjs": "^9.10.1",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/websockets": "^12.0.1",
    "@types/multer": "^2.2.0",
    "@uploadthing/react": "^7.3.3",
    "@upstash/redis": "^1.39.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "concurrently": "^10.0.5",
    "eslint-config-next": "^16.3.7",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "ioredis": "^6.0.0",
    "kysely": "^0.29.5",
    "multer": "^2.3.0",
    "next": "^16.4.0-canary.52",
    "nodemailer": "^10.0.12",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.23.0",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "redis": "^6.2.1",
    "socket.io": "^4.8.3",
    "stripe": "^22.6.1",
    "typescript": "^5.0.0",
    "uploadthing": "^7.7.4",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "i": "^0.3.7",
    "kysely-ctl": "^0.21.0",
    "npm": "^12.0.2",
    "postcss": "^8.5.27",
