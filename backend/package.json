{
  "name": "apexlearn",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true });\"",
    "build": "npx nest build && npm run build --prefix ../frontend",
    "start": "nest start",
    "db:migrate": "kysely migrate:latest",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "concurrently \"node dist/main\" \"npm start --prefix ../frontend\"",
    "build:monolith": "npm install && npm install --prefix ../frontend && npm run build",
    "lint": "eslint \"src/**/*.ts\" --fix"
  },
  "dependencies": {
    "@bull-board/api": "^9.10.1",
    "@bull-board/express": "^9.10.1",
    "@bull-board/nestjs": "^9.10.1",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/throttler": "^6.7.1",
    "@types/compression": "^1.8.1",
    "@upstash/redis": "^1.39.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "concurrently": "^10.0.5",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "kysely": "^0.29.5",
    "nodemailer": "^10.0.12",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "pusher": "^5.3.4",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "kysely-ctl": "^0.21.0",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.69.0"
  }
}
