generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  INSTRUCTOR
  ADMIN
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum UploadType {
  VIDEO
  IMAGE
  DOCUMENT
}

enum PricingType {
  FREE
  PAID
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  password     String
  name         String
  role         Role     @default(USER)
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  courses        Course[]        @relation("AuthoredCourses")
  enrollments    Enrollment[]
  reviews        Review[]
  refreshTokens  RefreshToken[]
  stars          Star[]
  comments       Comment[]
  progress       Progress[]
  uploads        Upload[]
  notifications  Notification[]
  conversations  Conversation[]  @relation("UserConversations")
  adminConversations Conversation[] @relation("AdminConversations")
  messages       Message[]

  @@index([role])
  @@index([deletedAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  courses Course[]
}

model Course {
  id          String       @id @default(uuid())
  title       String
  description String
  thumbnailUrl String?
  status      CourseStatus @default(DRAFT)

  pricingType PricingType  @default(FREE)
  price       Decimal?     @db.Decimal(10, 2)
  currency    String       @default("USD")

  authorId    String
  author      User         @relation("AuthoredCourses", fields: [authorId], references: [id])
  categoryId  String
  category    Category     @relation(fields: [categoryId], references: [id])

  enrollmentCount Int      @default(0)
  ratingAverage   Float    @default(0)
  ratingCount     Int      @default(0)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  sections    Section[]
  enrollments Enrollment[]
  reviews     Review[]
  stars       Star[]

  @@index([authorId])
  @@index([categoryId])
  @@index([status])
  @@index([deletedAt])
  @@index([title])
}

model Section {
  id        String   @id @default(uuid())
  title     String
  order     Int      @default(0)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  lessons Lesson[]

  @@index([courseId])
}

model Lesson {
  id          String   @id @default(uuid())
  title       String
  videoUrl    String?
  freePreview Boolean  @default(false)
  order       Int      @default(0)
  sectionId   String
  section     Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  comments Comment[]
  progress Progress[]

  @@index([sectionId])
}

model Enrollment {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  pricePaid Decimal? @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
  @@index([courseId])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@unique([userId, courseId])
  @@index([courseId])
}

model Star {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
  @@index([courseId])
}

model Comment {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
  deletedAt DateTime?

  @@index([lessonId])
}

model Progress {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed   Boolean  @default(true)
  completedAt DateTime @default(now())

  @@unique([userId, lessonId])
  @@index([lessonId])
}

model Upload {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  key        String
  bucket     String
  type       UploadType
  mimeType   String?
  sizeBytes  Int?
  createdAt  DateTime   @default(now())

  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model Conversation {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("UserConversations", fields: [userId], references: [id], onDelete: Cascade)
  adminId   String?
  admin     User?    @relation("AdminConversations", fields: [adminId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@index([userId])
  @@index([adminId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}
